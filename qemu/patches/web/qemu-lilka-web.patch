 }
 
+/* Whether check_interrupts() would raise an interrupt now. */
+static bool xtensa_irq_deliverable(CPUXtensaState *env)
+{
+    int minlevel = xtensa_get_cintlevel(env);
+    uint32_t int_set_enabled = qatomic_read(&env->sregs[INTSET]) &
+        (env->sregs[INTENABLE] | env->config->inttype_mask[INTTYPE_NMI]);
+
+    if (minlevel >= env->config->nmi_level) {
+        minlevel = env->config->nmi_level - 1;
+    }
+    for (int level = env->config->nlevel; level > minlevel; --level) {
+        if (env->config->level_mask[level] & int_set_enabled) {
+            return true;
+        }
+    }
+    return false;
+}
+
 void HELPER(check_interrupts)(CPUXtensaState *env)
 {
+    /* Every critical section enters and leaves through here (RSIL, WSR.PS),
+     * and almost always nothing is pending: then check_interrupts() would
+     * change nothing, so skip the BQL both vCPUs otherwise fight over. A
+     * device raising an IRQ meanwhile sets INTSET and then runs its own
+     * check_interrupts() under the BQL; with a barrier on both sides
+     * (there and here, after this vCPU's PS/INTENABLE store) at least one
+     * of the two sees the other's write. A stale CPU_INTERRUPT_HARD is
+     * re-checked against the current level when it is taken.
+     */
+    smp_mb();
+    if (!qatomic_read(&env->pending_irq_level) &&
+        !(qatomic_read(&env_cpu(env)->interrupt_request) & CPU_INTERRUPT_HARD) &&
+        !xtensa_irq_deliverable(env)) {
+        return;
+    }
     bql_lock();
     check_interrupts(env);
     bql_unlock();
