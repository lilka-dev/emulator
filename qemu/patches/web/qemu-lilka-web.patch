+/* Runs on the APP CPU between TBs, so it needs no CPU_INTERRUPT_HALT (one
+ * still pending after the release would halt the core again).
+ */
+static void esp32s3_apply_app_cpu_wait(CPUState *cpu, run_on_cpu_data data)
+{
+    bool wait = data.host_int != 0;
+    cpu_env(cpu)->runstall = wait;
+    cpu->halted = wait;
+}
+
+/* Queued in FIFO order, so a release always follows the stall before it. */
+static void esp32s3_app_cpu_wait(void *opaque, bool wait)
+{
+    Esp32s3SocState *s = ESP32S3_SOC(opaque);
+    async_run_on_cpu(CPU(&s->cpu[1]), esp32s3_apply_app_cpu_wait,
+                     RUN_ON_CPU_HOST_INT(wait));
+}
