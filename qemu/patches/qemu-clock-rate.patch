+/* Experimental Lilka fast-forward. Set once by board initialization, before
+ * vCPU threads start; default 100 preserves all ordinary QEMU clocks. This
+ * measures execution headroom, it does not reduce firmware work per guest sec.
+ */
+unsigned lilka_clock_rate_percent = 100;
+
+/* Optional MTTCG clock barrier. Device state is read only under BQL; this
+ * small mutex protects clock arithmetic alone and never calls back into BQL.
+ * Raw time is obtained before taking it, avoiding timer-lock inversion.
+ */
+static bool lilka_service_active;
+static QemuMutex lilka_service_mutex;
+static struct {
+    int64_t raw, value, limit, pending_since;
+    bool pending, bypass;
+    uint64_t fences, bypasses, max_lag;
+} lilka_service;
+
+bool lilka_service_clock_enabled(void)
+{
+    return qatomic_read(&lilka_service_active);
+}
+
+void lilka_service_clock_enable(void)
+{
+    assert(!icount_enabled());
+    assert(!lilka_service_clock_enabled());
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    qemu_mutex_init(&lilka_service_mutex);
+    lilka_service.raw = lilka_service.value = now;
+    lilka_service.limit = INT64_MAX;
+    qatomic_set(&lilka_service_active, true);
+}
+
+void lilka_service_clock_limit(int64_t limit_ns, bool irq_pending)
+{
+    if (!lilka_service_clock_enabled()) {
+        return;
+    }
+    qemu_mutex_lock(&lilka_service_mutex);
+    if (irq_pending && !lilka_service.pending) {
+        lilka_service.pending_since = lilka_service.raw;
+    }
+    if (!irq_pending) {
+        lilka_service.bypass = false;
+    }
+    lilka_service.pending = irq_pending;
+    lilka_service.limit = MAX(limit_ns, lilka_service.value);
+    qemu_mutex_unlock(&lilka_service_mutex);
+}
+
+static int64_t lilka_service_clock_now(int64_t raw)
+{
+    if (!lilka_service_clock_enabled()) {
+        return raw;
+    }
+    qemu_mutex_lock(&lilka_service_mutex);
+    /* Readers on different vCPUs may obtain raw timestamps out of order. */
+    int64_t delta = MAX(raw - lilka_service.raw, 0);
+    lilka_service.raw = MAX(lilka_service.raw, raw);
+    if (lilka_service.pending && !lilka_service.bypass &&
+        lilka_service.raw - lilka_service.pending_since >= 250000000) {
+        /* A guest may deliberately mask an enabled DMA interrupt. Avoid
+         * freezing such firmware forever; strict host-clock behavior then
+         * resumes for this unacknowledged interrupt epoch.
+         */
+        lilka_service.bypass = true;
+        lilka_service.bypasses++;
+    }
+    int64_t lag = lilka_service.raw - lilka_service.value;
+    int64_t advance = MIN(delta, lag);
+    advance += MIN(delta / 50, lag - advance); /* bounded 102% catch-up */
+    int64_t next = lilka_service.value + advance;
+    if (!lilka_service.bypass && next > lilka_service.limit) {
+        next = lilka_service.limit;
+        lilka_service.fences++;
+    }
+    lilka_service.value = next;
+    lilka_service.max_lag = MAX(lilka_service.max_lag,
+                               lilka_service.raw - next);
+    qemu_mutex_unlock(&lilka_service_mutex);
+    return next;
+}
+
+static unsigned lilka_service_wait_rate(void)
+{
+    unsigned rate = lilka_clock_rate_percent;
+    if (lilka_service_clock_enabled()) {
+        qemu_mutex_lock(&lilka_service_mutex);
+        if (lilka_service.raw > lilka_service.value) {
+            rate += rate / 50;
+        }
+        qemu_mutex_unlock(&lilka_service_mutex);
+    }
+    return rate;
+}
+
+void lilka_service_clock_report(void)
+{
+    if (!lilka_service_clock_enabled()) {
+        return;
+    }
+    qemu_mutex_lock(&lilka_service_mutex);
+    fprintf(stderr, "Lilka service clock fences=%" PRIu64
+            " watchdog_bypasses=%" PRIu64 " max_lag_ns=%" PRIu64 "\n",
+            lilka_service.fences, lilka_service.bypasses, lilka_service.max_lag);
+    qemu_mutex_unlock(&lilka_service_mutex);
+}
