+/* Experimental fixed-board SPI bank descriptor. SPDX-License-Identifier: MIT */
+#ifndef LILKA_INLINE_IO_H
+#define LILKA_INLINE_IO_H
+#include <stdint.h>
+typedef struct LilkaInlineIO {
+    uintptr_t banks;
+    intptr_t region_attr_offset;
+    intptr_t region_paddr_offset;
+    intptr_t watchpoints_offset;
+    intptr_t watch_addr_offset, watch_len_offset, watch_next_offset;
+} LilkaInlineIO;
+extern LilkaInlineIO lilka_inline_io;
+#endif
