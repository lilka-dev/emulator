+static void esp32s3_apply_cpu_stall(CPUState *cpu, run_on_cpu_data data)
+{
+    xtensa_runstall(cpu_env(cpu), data.host_int != 0);
+}
+
 static void esp32s3_cpu_stall(void* opaque, int n, int level)
 {
+    Esp32s3SocState *s = ESP32S3_SOC(opaque);
+    if (!g_getenv("LILKA_QEMU_CPU_STALL")) {
+        return;
+    }
+    /* RTC MMIO may be issued by the other core. Serialize execution-state
+     * changes on the owning CPU, retaining the FIFO order of stall/un-stall.
+     */
+    async_run_on_cpu(CPU(&s->cpu[n]), esp32s3_apply_cpu_stall,
+                     RUN_ON_CPU_HOST_INT(level != 0));
 }
 
