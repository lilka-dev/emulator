+void lilka_qemu_board_reset(void);
+void lilka_qemu_board_peripheral_reset(unsigned bank, uint32_t mask);
+
+static void esp32s3_peripheral_reset(void *opaque, unsigned bank, uint32_t mask)
+{
+    Esp32s3SocState *s = opaque;
+    lilka_qemu_board_peripheral_reset(bank, mask);
+    if (bank == 0) {
+        if (mask & BIT(1)) {
+            device_cold_reset(DEVICE(&s->spi1));
+        }
+        if (mask & BIT(2)) {
+            device_cold_reset(DEVICE(&s->uart[0]));
+        }
+        if (mask & BIT(5)) {
+            device_cold_reset(DEVICE(&s->uart[1]));
+        }
+        if (mask & BIT(13)) {
+            device_cold_reset(DEVICE(&s->timg[0]));
+        }
+        if (mask & BIT(15)) {
+            device_cold_reset(DEVICE(&s->timg[1]));
+        }
+        if (mask & BIT(29)) {
+            device_cold_reset(DEVICE(&s->systimer));
+        }
+    } else if (mask & BIT(9)) {
+        device_cold_reset(DEVICE(&s->uart[2]));
+    }
+}
+
