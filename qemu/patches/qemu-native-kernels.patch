+/* Optional bounded acceleration of a verified scalar halfword-fill loop.
+ * Unknown code, watchpoints and non-RAM mappings retain ordinary execution.
+ */
+uint64_t lilka_fill16_pixels, lilka_fill16_calls;
+uint64_t lilka_rom_udiv_calls, lilka_rom_udiv_zeroes;
+uint32_t HELPER(lilka_rom_udiv)(CPUXtensaState *env, uint32_t compat_zero)
+{
+    CPUWatchpoint *wp;
+    uint64_t numerator, denominator, quotient;
+    if (env->sregs[IBREAKENABLE]) {
+        return 0;
+    }
+    QTAILQ_FOREACH(wp, &env_cpu(env)->watchpoints, entry) {
+        if (wp->flags & BP_GDB) {
+            return 0;
+        }
+    }
+    /* Windowed ABI function replacement, not an ISA instruction replacement.
+     * ENTRY and RETW execute normally. Only ABI return registers are changed;
+     * caller-clobbered scratch registers/SAR need not reproduce the ROM's
+     * intermediate implementation. No guest memory is read or written here.
+     */
+    numerator = env->regs[2] | ((uint64_t)env->regs[3] << 32);
+    denominator = env->regs[4] | ((uint64_t)env->regs[5] << 32);
+    if (!denominator) {
+        if (!compat_zero) {
+            return 0; /* Original ROM raises its ordinary divide exception. */
+        }
+        /* Optional fast-profile compromise for C library division by zero,
+         * e.g. a firmware FPS display with a sub-millisecond frame. */
+        quotient = 0;
+        qatomic_fetch_add(&lilka_rom_udiv_zeroes, 1);
+    } else {
+        quotient = numerator / denominator;
+    }
+    env->regs[2] = quotient;
+    env->regs[3] = quotient >> 32;
+    qatomic_fetch_add(&lilka_rom_udiv_calls, 1);
+    return 1;
+}
+uint32_t HELPER(lilka_fill16)(CPUXtensaState *env, uint32_t mmu_idx)
+{
+    qatomic_fetch_add(&lilka_fill16_calls, 1);
+    int32_t index = env->regs[3], end = env->regs[5];
+    uint32_t address, count;
+    void *host;
+    if (index >= end || env->sregs[IBREAKENABLE]) {
+        return 0;
+    }
+    address = env->regs[4] + (uint32_t)index * 2;
+    if (address & 1) {
+        return 0;
+    }
+    count = MIN((int64_t)end - index, 256);
+    count = MIN(count, (TARGET_PAGE_SIZE - (address & ~TARGET_PAGE_MASK)) / 2);
+    /* Nonfaulting probe retains MMU/permission checks, handles dirty/code
+     * invalidation, and rejects MMIO/watchpoints before changing guest data.
+     * The batch never crosses a target page or skips a scalar fault.
+     */
+    if (probe_access_flags(env, address, count * 2, MMU_DATA_STORE, mmu_idx,
+                           true, &host, GETPC()) || !host) {
+        return 0;
+    }
+    for (unsigned i = 0; i < count; i++) {
+        qatomic_set((uint16_t *)host + i, cpu_to_le16((uint16_t)env->regs[7]));
+    }
+    env->regs[3] += count;
+    env->regs[9] = address + (count - 1) * 2;
+    qatomic_fetch_add(&lilka_fill16_pixels, count);
+    return count;
+}
