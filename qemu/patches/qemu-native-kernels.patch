+static bool gen_lilka_rom_udiv(CPUXtensaState *env, DisasContext *dc)
+{
+    /* ESP32-S3 rev0 ROM __udivdi3 body, after its ordinary ENTRY. Recognize
+     * every replaced byte, not an application address or a framework name.
+     * Only a digest is embedded; no ROM implementation is copied here.
+     */
+    const uint32_t start = 0x400568ff, end = 0x40056b6a;
+    uint8_t body[0x26b];
+    if (dc->pc != start || !g_getenv("LILKA_QEMU_ROM_UDIV") ||
+        dc->base.plugin_enabled || dc->icount || !dc->cwoe || dc->window < 3 ||
+        (tb_cflags(dc->base.tb) & (CF_USE_ICOUNT | CF_SINGLE_STEP |
+                                  CF_NO_GOTO_TB | CF_NO_GOTO_PTR)) ||
+        !QTAILQ_EMPTY(&env_cpu(env)->breakpoints) ||
+        (dc->lend > start && dc->lend <= end)) {
+        return false;
+    }
+    for (unsigned i = 0; i < sizeof(body); i++) {
+        body[i] = translator_ldub(env, &dc->base, start + i);
+    }
+    char *digest = g_compute_checksum_for_data(G_CHECKSUM_SHA256, body,
+                                              sizeof(body));
+    bool match = !strcmp(digest,
+        "defe672601e172010691d15ace97665b30be5ebfbae366dea802e6786074c0c9");
+    g_free(digest);
+    if (!match) {
+        return false;
+    }
+    TCGLabel *fallback = gen_new_label();
+    TCGv_i32 done = tcg_temp_new_i32();
+    gen_helper_lilka_rom_udiv(done, tcg_env,
+        tcg_constant_i32(g_getenv("LILKA_QEMU_ROM_DIV_COMPAT") != NULL));
+    tcg_gen_brcondi_i32(TCG_COND_EQ, done, 0, fallback);
+    gen_jumpi(dc, end - 2, 0); /* Execute the original RETW, including checks. */
+    gen_set_label(fallback);
+    dc->base.is_jmp = DISAS_NEXT;
+    return true;
+}
+
+static bool gen_lilka_fill16(CPUXtensaState *env, DisasContext *dc)
+{
+    /* Recognize instructions, never a firmware address or framework ABI:
+     * bge a3,a5,+64; slli a9,a3,1; add.n a9,a4,a9;
+     * s16i a7,a9,0; addi.n a3,a3,1; j -13.
+     */
+    static const uint8_t pattern[] = {
+        0x57,0xa3,0x3c,0xf0,0x93,0x11,0x9a,0x94,
+        0x72,0x59,0x00,0x1b,0x33,0xc6,0xfb,0xff
+    };
+    uint32_t pc = dc->pc;
+    if (!g_getenv("LILKA_QEMU_FILL16") || dc->base.plugin_enabled ||
+        (tb_cflags(dc->base.tb) & (CF_USE_ICOUNT | CF_SINGLE_STEP |
+                                  CF_NO_GOTO_TB | CF_NO_GOTO_PTR)) ||
+        dc->icount || dc->window < 2 ||
+        !((pc >= 0x42000000 && pc < 0x44000000) ||
+          (pc >= 0x40370000 && pc < 0x403e0000)) ||
+        (pc & ~TARGET_PAGE_MASK) > TARGET_PAGE_SIZE - sizeof(pattern) ||
+        (dc->lend > pc && dc->lend <= pc + sizeof(pattern))) {
+        return false;
+    }
+    for (unsigned i = 0; i < sizeof(pattern); i++) {
+        if (translator_ldub(env, &dc->base, pc + i) != pattern[i]) {
+            return false;
+        }
+    }
+    TCGLabel *fallback = gen_new_label();
+    TCGv_i32 count = tcg_temp_new_i32();
+    tcg_gen_brcond_i32(TCG_COND_GE, cpu_R[3], cpu_R[5], fallback);
+    gen_helper_lilka_fill16(count, tcg_env, tcg_constant_i32(dc->cring));
+    tcg_gen_brcondi_i32(TCG_COND_EQ, count, 0, fallback);
+    dc->lilka_fill16 = true;
+    gen_jumpi(dc, pc, 0);
+    gen_set_label(fallback);
+    dc->base.is_jmp = DISAS_NEXT;
+    return true;
+}
