--- a/system/main.c
+++ b/system/main.c
@@ -42,8 +42,50 @@
 
 int (*qemu_main)(void) = qemu_default_main;
 
+
+#ifdef LILKA_EMBEDDED_DESKTOP
+#include "qemu/main-loop.h"
+#include "sysemu/runstate.h"
+#include "sysemu/reset.h"
+#include "qemu/atomic.h"
+extern int lilka_desktop_main(void);
+extern void lilka_board_shutdown(void);
+static bool lilka_ready;
+
+bool lilka_cpu_ready(void) { return qatomic_read(&lilka_ready); }
+int lilka_cpu_run(int argc, char **argv)
+{
+    qemu_init(argc, argv);
+    qatomic_set(&lilka_ready, true);
+    int status = qemu_default_main();
+    qatomic_set(&lilka_ready, false);
+    lilka_board_shutdown();
+    return status;
+}
+void lilka_cpu_shutdown(void)
+{
+    if (!lilka_cpu_ready()) { return; }
+    bql_lock();
+    qemu_system_shutdown_request(SHUTDOWN_CAUSE_HOST_QMP_QUIT);
+    bql_unlock();
+}
+void lilka_cpu_reset(void)
+{
+    if (!lilka_cpu_ready()) { return; }
+    bql_lock();
+    qemu_system_reset_request(SHUTDOWN_CAUSE_HOST_QMP_SYSTEM_RESET);
+    bql_unlock();
+}
+#endif
+
 int main(int argc, char **argv)
 {
+#ifdef LILKA_EMBEDDED_DESKTOP
+    if (argc <= 1 || strcmp(argv[1], "--cpu-only") != 0) {
+        return lilka_desktop_main();
+    }
+    argv++; argc--;
+#endif
     qemu_init(argc, argv);
     return qemu_main();
 }
